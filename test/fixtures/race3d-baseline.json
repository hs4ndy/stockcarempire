  "approvedUpdates": {
    "version111": "Only spark emitter/step, dual HUD and launch labels updated for requested condition visuals.",
    "version112": "Intentional player penalty/draft and AI-only contact tuning; opening/dual traces refreshed.",
    "version113": "Requested 80% less condition loss and softer human condition/wreck pace; trace baselines refreshed.",
    "version122": "HUD-only 20Hz DOM refresh throttle. Physics, cameras, spark/contact methods unchanged.",
    "version123": "Rival flag propagation, red banner/order styles and near-human +.04 aggression; no pace/recovery/contact changes.",
    "version125": "Pro/All-Out human-pair AI strain -.10 relative; single/dual victory presentation. No other driving or spark changes.",
    "version127": "Cosmetic stripe buffers, appearance propagation, number-color textures and preview-only RNG bypass. Driving, contact, cameras and seeded race state unchanged.",
    "version129": "Cosmetic hood decal buffers/materials and shared logo texture lifetime only; no racing changes.",
    "version130": "AI-only deterministic appearance defaults, no physics method changes.",
    "version131": "Requested All-Out contact resistance and difficulty racecraft/aggression tuning; intentional All-Out trace refresh.",
    "version132": "Requested small All-Out contact easing: human-caused AI strain .04->.05; human threshold80->88. Other modes unchanged."
  }
